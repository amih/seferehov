# Copy to /etc/systemd/system/ and set User/paths (see README). Reads book lists from
# publishers' websites into the local index, politely (scripts/sites.js, at most 2,000 pages a day).
[Unit]
Description=Seferehov: read book lists from publishers' websites
After=network-online.target docker.service

[Service]
Type=oneshot
User=APP_USER
WorkingDirectory=APP_DIR/server
ExecStart=/usr/bin/env node --env-file=../.env scripts/sites.js crawl
Nice=19
TimeoutStartSec=20h
